# Copy this file to .env and fill in your own values. Never commit .env.
#
# For QQ Mail: Settings → Account → POP3/IMAP service, then generate an
# authorisation code. Use that code as IMAP_PASSWORD, not your login password.
IMAP_HOST=imap.qq.com
IMAP_PORT=993
IMAP_TLS=true
IMAP_USER=your-account@example.com
IMAP_PASSWORD=your-app-password
IMAP_MAILBOX=INBOX
IMAP_UNSEEN_ONLY=true
IMAP_LIMIT=10
