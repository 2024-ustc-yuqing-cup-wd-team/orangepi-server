[Unit]
Description=MyHomePage API (USTC MyHomePage)
Documentation=https://github.com/2024-ustc-yuqing-cup-wd-team/orangepi-server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/myhomepage-api
Environment=PATH=/usr/local/bin:/usr/bin:/bin
EnvironmentFile=/opt/myhomepage-api/.env
ExecStart=/usr/bin/env node src/index.js
Restart=on-failure
RestartSec=5s

# Hardening: the service only needs to read its own files and answer HTTP.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6
LockPersonality=true

[Install]
WantedBy=multi-user.target
